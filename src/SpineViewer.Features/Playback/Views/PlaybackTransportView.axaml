<UserControl
    x:Class="SpineViewer.Features.Playback.Views.PlaybackTransportView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="https://github.com/projektanker/icons.avalonia"
    xmlns:playbackModels="using:SpineViewer.Features.Playback.Models"
    xmlns:viewModels="using:SpineViewer.Features.Playback.ViewModels"
    x:DataType="viewModels:PlaybackTransportViewModel">
    <Border
        Background="#EB1A1817"
        BorderBrush="{DynamicResource LineStrong}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="8,6">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
            <!-- Play / pause -->
            <Button
                Classes="accent transport"
                Command="{Binding TogglePlayPauseCommand}"
                >
                <Panel>
                    <i:Icon FontSize="11" Foreground="#151312" IsVisible="{Binding !IsPlaying}" Value="fa-solid fa-play" />
                    <i:Icon FontSize="11" Foreground="#151312" IsVisible="{Binding IsPlaying}" Value="fa-solid fa-pause" />
                </Panel>
            </Button>

            <!-- Stop -->
            <Button
                Classes="transport"
                Classes.stopActive="{Binding IsStopped}"
                Command="{Binding StopCommand}"
                Grid.Column="1"
                Margin="8,0,0,0">
                <i:Icon FontSize="11" Foreground="{Binding $parent[Button].Foreground}" Value="fa-solid fa-stop" />
            </Button>

            <!-- Step forward -->
            <Button Classes="transport" Command="{Binding FrameStepCommand}" Grid.Column="2" Margin="6,0,0,0">
                <i:Icon FontSize="11" Foreground="{Binding $parent[Button].Foreground}" Value="fa-solid fa-forward-step" />
            </Button>

            <!-- Timeline -->
            <Slider
                Classes="timeline"
                Grid.Column="3"
                IsEnabled="{Binding HasActiveSession}"
                Margin="10,0"
                Maximum="{Binding TimelineMaximumSeconds}"
                Minimum="0"
                Value="{Binding TimelinePositionSeconds}" />

            <!-- Time -->
            <TextBlock
                Classes="mono"
                Grid.Column="4"
                MinWidth="100"
                Text="{Binding TimeSummaryText}"
                TextAlignment="Right"
                VerticalAlignment="Center" />

            <!-- Loop -->
            <ToggleButton
                Classes="transport"
                Grid.Column="5"
                IsChecked="{Binding IsLooping}"
                Margin="8,0,0,0"
                ToolTip.Tip="Loop">
                <i:Icon FontSize="11" Foreground="{Binding $parent[ToggleButton].Foreground}" Value="fa-solid fa-rotate-right" />
            </ToggleButton>

            <!-- Speed -->
            <ComboBox
                Grid.Column="6"
                ItemsSource="{Binding SpeedOptions}"
                Margin="8,0,0,0"
                MinWidth="84"
                SelectedItem="{Binding SelectedSpeedOption}"
                VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="playbackModels:PlaybackSpeedOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </Border>
</UserControl>
