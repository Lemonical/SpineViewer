<UserControl
    x:Class="SpineViewer.Features.Playback.Views.AnimationTrackEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreModels="using:SpineViewer.Core.Models"
    xmlns:i="https://github.com/projektanker/icons.avalonia"
    xmlns:playbackModels="using:SpineViewer.Features.Playback.Models"
    xmlns:viewModels="using:SpineViewer.Features.Playback.ViewModels"
    x:DataType="viewModels:AnimationTrackEditorViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Classes="section" Text="TRACK STACK" />
                <TextBlock Classes="hint" FontSize="10" Text="Tracks update immediately so layering stays visible while you edit." TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox ItemsSource="{Binding AvailableAnimationNames}" SelectedItem="{Binding SelectedNewTrackAnimationName}" />
                <Button Classes="accentOutline" Command="{Binding AddTrackCommand}" Content="Add" Grid.Column="1" i:Attached.Icon="fa-solid fa-plus" />
            </Grid>

            <TextBlock
                Classes="hint"
                IsVisible="{Binding HasNoTracks}"
                Text="{Binding EmptyStateText}"
                TextWrapping="Wrap" />

            <ListBox Classes="studio" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="coreModels:AnimationTrackState">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Border
                                Background="{DynamicResource LineStrong}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                                <TextBlock Classes="mono" Text="{Binding TrackIndex, StringFormat=#{0}}" />
                            </Border>
                            <TextBlock FontSize="12" FontWeight="Medium" Grid.Column="1" Text="{Binding AnimationName}" VerticalAlignment="Center" />
                            <TextBlock Classes="mono" Grid.Column="2" Text="{Binding TimeScale, StringFormat={}{0:0.00}×}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected track editor -->
            <Border Classes="card" IsVisible="{Binding HasSelectedTrack}" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="section" Text="SELECTED TRACK" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock FontSize="12" Text="Animation" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableAnimationNames}" SelectedItem="{Binding SelectedTrackAnimationName}" />

                        <TextBlock FontSize="12" Grid.Row="1" Text="Enabled" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" Grid.Row="1" IsChecked="{Binding SelectedTrackIsEnabled}" />

                        <TextBlock FontSize="12" Grid.Row="2" Text="Loop" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" Grid.Row="2" IsChecked="{Binding SelectedTrackIsLooping}" />

                        <TextBlock FontSize="12" Grid.Row="3" Text="Speed" VerticalAlignment="Center" />
                        <NumericUpDown
                            Grid.Column="1"
                            Grid.Row="3"
                            Increment="0.05"
                            Maximum="4.0"
                            Minimum="0.1"
                            Value="{Binding SelectedTrackTimeScale}" />

                        <TextBlock FontSize="12" Grid.Row="4" Text="Mix (s)" VerticalAlignment="Center" />
                        <NumericUpDown
                            Grid.Column="1"
                            Grid.Row="4"
                            Increment="0.05"
                            Maximum="5"
                            Minimum="0"
                            Value="{Binding SelectedTrackMixDurationSeconds}" />
                    </Grid>
                    <WrapPanel>
                        <Button Classes="toolbar" Command="{Binding MoveSelectedTrackUpCommand}" Content="Move Up" Margin="0,0,6,0" i:Attached.Icon="fa-solid fa-arrow-up" />
                        <Button Classes="toolbar" Command="{Binding MoveSelectedTrackDownCommand}" Content="Move Down" Margin="0,0,6,0" i:Attached.Icon="fa-solid fa-arrow-down" />
                        <Button Classes="toolbar" Command="{Binding RemoveSelectedTrackCommand}" Content="Remove" i:Attached.Icon="fa-solid fa-trash" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock
                Classes="hint"
                IsVisible="{Binding HasNoSelectedTrack}"
                Text="Select a track to edit its animation, blend, and loop settings."
                TextWrapping="Wrap" />

            <!-- Validation -->
            <StackPanel Spacing="4">
                <TextBlock Classes="section" Text="{Binding ValidationSummaryText}" />
                <ItemsControl ItemsSource="{Binding ValidationIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="playbackModels:PlaybackTrackValidationIssue">
                            <TextBlock Classes="hint" FontSize="10" Text="{Binding Message}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
