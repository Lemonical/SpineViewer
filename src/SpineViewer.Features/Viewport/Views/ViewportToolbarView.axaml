<UserControl
    x:Class="SpineViewer.Features.Viewport.Views.ViewportToolbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="https://github.com/projektanker/icons.avalonia"
    xmlns:viewModels="using:SpineViewer.Features.Viewport.ViewModels"
    x:DataType="viewModels:ViewportViewModel">
    <Border
        Background="{DynamicResource SurfaceBase}"
        BorderBrush="{DynamicResource LineSubtle}"
        BorderThickness="0,0,0,1"
        Padding="8,5">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Classes="toolbar" Command="{Binding FitToViewCommand}" Content="Fit" i:Attached.Icon="fa-solid fa-expand" />
                <Button Classes="toolbar" Command="{Binding ResetCameraCommand}" Content="Reset" i:Attached.Icon="fa-solid fa-crosshairs" />
                <Button Classes="toolbar" Command="{Binding ZoomOutCommand}" Content="Zoom Out" i:Attached.Icon="fa-solid fa-magnifying-glass-minus" />
                <Button Classes="toolbar" Command="{Binding ZoomInCommand}" Content="Zoom In" i:Attached.Icon="fa-solid fa-magnifying-glass-plus" />
                <TextBlock
                    Classes="mono"
                    Margin="4,0"
                    Text="{Binding ZoomSummaryText}"
                    VerticalAlignment="Center" />

                <Border Classes="divider" Height="16" Margin="2,0" />

                <ToggleButton Classes="pill" Content="Grid" IsChecked="{Binding IsGridVisible}" />
                <ToggleButton Classes="pill" Content="Origin" IsChecked="{Binding IsOriginVisible}" />
                <ToggleButton Classes="pill" Content="Bones" IsChecked="{Binding IsBonesVisible}" />
                <ToggleButton Classes="pill" Content="Bounds" IsChecked="{Binding IsBoundsVisible}" />
                <ToggleButton Classes="pill" Content="Mesh" IsChecked="{Binding IsMeshWireframeVisible}" />
                <ToggleButton Classes="pill" Content="Slots" IsChecked="{Binding IsSlotOutlinesVisible}" />
                <ToggleButton Classes="pill" Content="Labels" IsChecked="{Binding IsLabelsVisible}" />
                <ToggleButton Classes="pill" Content="Missing" IsChecked="{Binding IsMissingResourceIndicatorsVisible}" />
                <ToggleButton Classes="pill" Content="Warn" IsChecked="{Binding IsUnsupportedFeatureIndicatorsVisible}" />

                <Border Classes="divider" Height="16" Margin="2,0" />

                <ComboBox
                    ItemsSource="{Binding BackgroundOptions}"
                    MinWidth="120"
                    SelectedItem="{Binding SelectedBackgroundStyle}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
