<UserControl
    x:Class="SpineViewer.Features.Viewport.Views.ViewportToolbarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SpineViewer.Features.Viewport.ViewModels"
    x:DataType="viewModels:ViewportViewModel">
    <Border
        Background="#101A29"
        BorderBrush="#263547"
        BorderThickness="1"
        CornerRadius="16"
        Padding="12">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
                <Button Command="{Binding FitToViewCommand}" Content="Fit" MinWidth="72" />
                <Button Command="{Binding ResetCameraCommand}" Content="Reset" Margin="10,0,0,0" MinWidth="72" />
                <Button Command="{Binding ZoomOutCommand}" Content="-" Margin="10,0,0,0" MinWidth="44" />
                <Button Command="{Binding ZoomInCommand}" Content="+" Margin="10,0,0,0" MinWidth="44" />

                <CheckBox Content="Grid" IsChecked="{Binding IsGridVisible}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Origin" IsChecked="{Binding IsOriginVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Bones" IsChecked="{Binding IsBonesVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Bounds" IsChecked="{Binding IsBoundsVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Mesh" IsChecked="{Binding IsMeshWireframeVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Slots" IsChecked="{Binding IsSlotOutlinesVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Labels" IsChecked="{Binding IsLabelsVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Missing" IsChecked="{Binding IsMissingResourceIndicatorsVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="Warnings" IsChecked="{Binding IsUnsupportedFeatureIndicatorsVisible}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                <ComboBox
                    HorizontalAlignment="Right"
                    ItemsSource="{Binding BackgroundOptions}"
                    MinWidth="130"
                    SelectedItem="{Binding SelectedBackgroundStyle}" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding ZoomSummaryText}" />
            </StackPanel>

            <TextBlock
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Classes="hint"
                Text="{Binding InteractionHintText}"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
