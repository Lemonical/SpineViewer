<UserControl
    x:Class="SpineViewer.Features.Viewport.Views.ViewportView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SpineViewer.Features.Viewport.ViewModels"
    xmlns:views="using:SpineViewer.Features.Viewport.Views"
    x:DataType="viewModels:ViewportViewModel">
    <views:SpineRenderHost x:Name="RenderHost" Focusable="True" Scene="{Binding RenderScene}" />
</UserControl>
