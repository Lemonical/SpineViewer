<Window
    x:Class="SpineViewer.Features.Shell.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:SpineViewer.Features.Shell.ViewModels"
    Width="980"
    Height="680"
    MinWidth="720"
    MinHeight="480"
    x:DataType="viewModels:MainWindowViewModel"
    Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="28">
        <StackPanel Spacing="8">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding WelcomeMessage}" />
            <TextBlock Classes="hint" Text="{Binding RuntimeSummary}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,24,0,24"
            Padding="24"
            Background="#141A23"
            BorderBrush="#3A4457"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="12">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Workspace" />
                <TextBlock TextWrapping="Wrap" Text="{Binding SessionSummary}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding DiagnosticSummary}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding RecentFilesSummary}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" HorizontalAlignment="Left" Text="{Binding StatusText}" />
    </Grid>
</Window>
