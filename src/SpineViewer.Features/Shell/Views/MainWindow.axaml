<Window
    x:Class="SpineViewer.Features.Shell.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:shellViews="using:SpineViewer.Features.Shell.Views"
    xmlns:viewModels="using:SpineViewer.Features.Shell.ViewModels"
    Width="1280"
    Height="840"
    MinWidth="720"
    MinHeight="560"
    Background="{DynamicResource SurfaceBase}"
    x:DataType="viewModels:MainWindowViewModel"
    Title="{Binding Title}">
    <Grid>
        <shellViews:MainShellView />

        <Border
            x:Name="ResizeNorthGrip"
            Background="Transparent"
            Cursor="SizeNorthSouth"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top" />
        <Border
            x:Name="ResizeSouthGrip"
            Background="Transparent"
            Cursor="SizeNorthSouth"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom" />
        <Border
            x:Name="ResizeEastGrip"
            Background="Transparent"
            Cursor="SizeWestEast"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="6" />
        <Border
            x:Name="ResizeWestGrip"
            Background="Transparent"
            Cursor="SizeWestEast"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Width="6" />

        <Border
            x:Name="ResizeNorthWestGrip"
            Background="Transparent"
            Cursor="TopLeftCorner"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="10" />
        <Border
            x:Name="ResizeNorthEastGrip"
            Background="Transparent"
            Cursor="TopRightCorner"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="10" />
        <Border
            x:Name="ResizeSouthWestGrip"
            Background="Transparent"
            Cursor="BottomLeftCorner"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Width="10" />
        <Border
            x:Name="ResizeSouthEastGrip"
            Background="Transparent"
            Cursor="BottomRightCorner"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="10" />
    </Grid>
</Window>
