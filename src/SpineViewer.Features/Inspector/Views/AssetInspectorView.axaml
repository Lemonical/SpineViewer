<UserControl
    x:Class="SpineViewer.Features.Inspector.Views.AssetInspectorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreModels="using:SpineViewer.Core.Models"
    xmlns:inspectorViewModels="using:SpineViewer.Features.Inspector.ViewModels"
    x:DataType="inspectorViewModels:AssetInspectorViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock
            Classes="hint"
            Margin="0,0,0,10"
            Text="{Binding ExportSummaryText}"
            TextWrapping="Wrap" />

        <TextBlock
            Classes="hint"
            Grid.Row="1"
            IsVisible="{Binding !HasActiveSession}"
            Text="{Binding EmptyStateText}"
            TextWrapping="Wrap"
            VerticalAlignment="Top" />

        <TabControl Classes="sub" Grid.Row="1" IsVisible="{Binding HasActiveSession}">
            <!-- Animations -->
            <TabItem Header="Anim">
                <ListBox Classes="studio" ItemsSource="{Binding Animations}" Margin="0,8,0,0" SelectedItem="{Binding SelectedAnimation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="coreModels:SpineAnimationInfo">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1">
                                    <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Name}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="hint" FontSize="10" Text="{Binding TimelineCount}" />
                                        <TextBlock Classes="hint" FontSize="10" Text="timelines ·" />
                                        <TextBlock Classes="hint" FontSize="10" Text="{Binding KeyframeCount}" />
                                        <TextBlock Classes="hint" FontSize="10" Text="kf" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Classes="mono"
                                    Grid.Column="1"
                                    Text="{Binding Duration, StringFormat={}{0:ss\\.ff}s}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Bones -->
            <TabItem Header="Bones">
                <TreeView ItemsSource="{Binding BoneTree}" Margin="0,8,0,0">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="inspectorViewModels:BoneTreeNodeViewModel" ItemsSource="{Binding Children}">
                            <TextBlock FontSize="12" Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </TabItem>

            <!-- Skins -->
            <TabItem Header="Skins">
                <ListBox Classes="studio" ItemsSource="{Binding Skins}" Margin="0,8,0,0" SelectedItem="{Binding SelectedSkin}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="coreModels:SpineSkinInfo">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Name}" />
                                <TextBlock Classes="hint" FontSize="10" Text="{Binding AttachmentCount, StringFormat={}{0} attachments}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Slots -->
            <TabItem Header="Slots">
                <ListBox Classes="studio" ItemsSource="{Binding Slots}" Margin="0,8,0,0" SelectedItem="{Binding SelectedSlot}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="coreModels:SpineSlotInfo">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Name}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding BoneName}" />
                                    <TextBlock Classes="hint" FontSize="10" Text="·" />
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding BlendMode}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Atlas -->
            <TabItem Header="Atlas">
                <ListBox Classes="studio" ItemsSource="{Binding AtlasPages}" Margin="0,8,0,0" SelectedItem="{Binding SelectedAtlasPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="coreModels:SpineAtlasPageInfo">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding Name}" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding Width}" />
                                    <TextBlock Classes="hint" FontSize="10" Text="×" />
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding Height}" />
                                    <TextBlock Classes="hint" FontSize="10" Text="·" />
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding Filter}" />
                                    <TextBlock Classes="hint" FontSize="10" Text="·" />
                                    <TextBlock Classes="hint" FontSize="10" Text="{Binding RegionCount, StringFormat={}{0} regions}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Runtime -->
            <TabItem Header="Runtime">
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="section" Text="CAPABILITIES" />
                        <ItemsControl ItemsSource="{Binding RuntimeCapabilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="coreModels:SpineRuntimeFeatureSupport">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock FontSize="12" Text="{Binding Feature}" />
                                        <TextBlock
                                            FontSize="12"
                                            Grid.Column="1"
                                            Text="{Binding IsSupported}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="section" Margin="0,8,0,0" Text="WARNINGS &amp; LIMITS" />
                        <ItemsControl ItemsSource="{Binding UnsupportedFeatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="coreModels:UnsupportedSpineFeature">
                                    <StackPanel Margin="0,0,0,8" Spacing="1">
                                        <TextBlock FontSize="12" FontWeight="Medium" Text="{Binding DisplayName}" />
                                        <TextBlock Classes="hint" FontSize="10" Text="{Binding Details}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
