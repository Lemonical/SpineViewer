<UserControl
    x:Class="SpineViewer.Features.Settings.Views.ViewerSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="https://github.com/projektanker/icons.avalonia"
    xmlns:viewModels="using:SpineViewer.Features.Settings.ViewModels"
    x:DataType="viewModels:ViewerSettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Appearance -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="APPEARANCE" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Theme" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding ThemeOptions}"
                        MinWidth="100"
                        SelectedItem="{Binding SelectedTheme}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Restore session" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding RestoreLastSessionOnStartup}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Custom title bar" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomTitleBar}" />
                </Grid>
                <TextBlock Classes="hint" FontSize="10" Text="{Binding WindowStateSummaryText}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Default overlays -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="DEFAULT OVERLAYS" />
                <WrapPanel>
                    <ToggleButton Classes="pill" Content="Grid" IsChecked="{Binding ShowGridByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Origin" IsChecked="{Binding ShowOriginByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Bones" IsChecked="{Binding ShowBonesByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Bounds" IsChecked="{Binding ShowBoundsByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Mesh" IsChecked="{Binding ShowMeshWireframeByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Slots" IsChecked="{Binding ShowSlotOutlinesByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Labels" IsChecked="{Binding ShowLabelsByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Missing" IsChecked="{Binding ShowMissingResourceIndicatorsByDefault}" Margin="0,0,4,4" />
                    <ToggleButton Classes="pill" Content="Warn" IsChecked="{Binding ShowUnsupportedFeatureIndicatorsByDefault}" Margin="0,0,4,4" />
                </WrapPanel>
            </StackPanel>

            <!-- Playback -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="PLAYBACK" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Loop by default" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding LoopPlaybackByDefault}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Default speed" VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Increment="0.05"
                        Maximum="4.0"
                        Minimum="0.1"
                        MinWidth="110"
                        Value="{Binding DefaultPlaybackSpeed}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Track speed" VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Increment="0.05"
                        Maximum="4.0"
                        Minimum="0.1"
                        MinWidth="110"
                        Value="{Binding DefaultTrackTimeScale}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Track mix (s)" VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Increment="0.05"
                        Maximum="5"
                        Minimum="0"
                        MinWidth="110"
                        Value="{Binding DefaultTrackMixDurationSeconds}" />
                </Grid>
            </StackPanel>

            <!-- Viewport & recents -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="VIEWPORT &amp; RECENTS" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Background" VerticalAlignment="Center" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding BackgroundOptions}"
                        MinWidth="110"
                        SelectedItem="{Binding DefaultViewportBackgroundStyle}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock FontSize="12" Text="Recent limit" VerticalAlignment="Center" />
                    <NumericUpDown
                        Grid.Column="1"
                        Increment="1"
                        Maximum="50"
                        Minimum="1"
                        MinWidth="110"
                        Value="{Binding RecentFilesLimit}" />
                </Grid>
            </StackPanel>

            <!-- Persistence -->
            <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="PERSISTENCE" />
                <TextBlock Classes="hint" Text="{Binding StatusText}" TextWrapping="Wrap" />
                <Button
                    Command="{Binding ResetSettingsCommand}"
                    Content="Reset to Defaults"
                    HorizontalAlignment="Left"
                    i:Attached.Icon="fa-solid fa-rotate-left" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
